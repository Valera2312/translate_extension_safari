{
  "manifest_version": 3,
  "name": "DeepL Translator (RU-EN)",
  "version": "1.0.0",
  "description": "Перевод страниц Русский ↔ Английский через DeepL API",
  "permissions": [
    "contextMenus",
    "storage",
    "scripting",
    "activeTab"
  ],
  "host_permissions": [
    "https://api.deepl.com/",
    "https://api-free.deepl.com/"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Настройки DeepL"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
